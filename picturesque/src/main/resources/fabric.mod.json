{
	"schemaVersion": 1,
	"id": "picturesque",
	"version": "${version}",
	"name": "Picturesque",
	"description": "A cozy gouache-grade look for Lamplight: buttery sun, periwinkle shadows, biome fog, amber lantern glow, plus an optional voxel-raytraced light pass with bloom.",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/picturesque/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.aura.picturesque.Picturesque"
		],
		"client": [
			"com.aura.picturesque.client.PicturesqueClient"
		]
	},
	"mixins": [
		"picturesque.mixins.json",
		{
			"config": "picturesque.client.mixins.json",
			"environment": "client"
		},
		{
			"config": "picturesque.raytrace.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}