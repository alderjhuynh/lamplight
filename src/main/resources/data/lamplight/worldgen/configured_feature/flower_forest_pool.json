{
  "type": "minecraft:waterlogged_vegetation_patch",
  "config": {
    "surface": "floor",
    "depth": 1,
    "vertical_range": 4,
    "extra_bottom_block_chance": 0.5,
    "extra_edge_column_chance": 0.5,
    "vegetation_chance": 0.05,
    "xz_radius": 3,
    "replaceable": "#minecraft:substrate_overworld",
    "ground_state": {
      "type": "minecraft:rule_based_state_provider",
      "fallback": {
        "type": "minecraft:simple_state_provider",
        "state": {
          "Name": "minecraft:grass_block",
          "Properties": {
            "snowy": "false"
          }
        }
      },
      "rules": [
        {
          "if_true": {
            "type": "minecraft:all_of",
            "predicates": [
              {
                "type": "minecraft:matching_block_tag",
                "tag": "minecraft:grass_blocks"
              },
              {
                "type": "minecraft:not",
                "predicate": {
                  "type": "minecraft:matching_block_tag",
                  "offset": [
                    0,
                    1,
                    0
                  ],
                  "tag": "lamplight:sustains_grass_under_rock"
                }
              }
            ]
          },
          "then": {
            "type": "minecraft:simple_state_provider",
            "state": {
              "Name": "minecraft:dirt"
            }
          }
        }
      ]
    },
    "vegetation_feature": {
      "feature": "lamplight:forest_rock",
      "placement": []
    }
  }
}