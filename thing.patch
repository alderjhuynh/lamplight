+package com.aura.lamplight.armory;
+
+import java.util.Map;
+import java.util.UUID;
+import java.util.concurrent.ConcurrentHashMap;
+
+import net.fabricmc.fabric.api.event.lifecycle.v1.ServerTickEvents;
+import net.fabricmc.fabric.api.networking.v1.ServerPlayConnectionEvents;
+import net.minecraft.core.particles.ColorParticleOption;
+import net.minecraft.core.particles.ParticleTypes;
+import net.minecraft.resources.Identifier;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.sounds.SoundEvents;
+import net.minecraft.sounds.SoundSource;
+import net.minecraft.tags.DamageTypeTags;
+import net.minecraft.world.InteractionHand;
+import net.minecraft.world.damagesource.DamageSource;
+import net.minecraft.world.damagesource.DamageTypes;
+import net.minecraft.world.effect.MobEffectInstance;
+import net.minecraft.world.effect.MobEffects;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.LivingEntity;
+import net.minecraft.world.entity.Mob;
+import net.minecraft.world.entity.ai.attributes.AttributeInstance;
+import net.minecraft.world.entity.ai.attributes.AttributeModifier;
+import net.minecraft.world.entity.ai.attributes.Attributes;
+import net.minecraft.world.entity.player.Player;
+import net.minecraft.world.item.Item;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.phys.Vec3;
+
+/**
+ * Server-side rapier mechanics: the parry window, the riposte crit and the every-third-hit thrust.
+ *
+ * <p>Thrust state is mirrored to the client for free: while a thrust is ready the server keeps a
+ * transient {@code entity_interaction_range} modifier on the player. Vanilla syncs attributes, so the
+ * client's targeting range, its attack code and the first-person animation can all read the thrust
+ * state off that modifier ({@link #isThrustReady(Player)}) without any custom packet.
+ */
+public final class RapierCombat {
+	private RapierCombat() {}
+
+	// ---- parry --------------------------------------------------------------------------------
+
+	/** Length of the parry window, ~0.3s. Also the use duration of the rapier. */
+	public static final int PARRY_TICKS = 6;
+	/** Item cooldown after a parry that did not catch anything. */
+	public static final int PARRY_WHIFF_COOLDOWN_TICKS = 30;
+	/** Short lockout after a successful parry so it can not be chained into permanent invulnerability. */
+	public static final int PARRY_SUCCESS_COOLDOWN_TICKS = 8;
+	/** Horizontal speed of the hop back when the parry starts. */
+	public static final double PARRY_HOP_STRENGTH = 0.45D;
+	/** Extra vertical speed of the hop back (only when standing on the ground). */
+	public static final double PARRY_HOP_LIFT = 0.2D;
+
+	/** How long a parried melee attacker is slowed for. */
+	public static final int STAGGER_TICKS = 20;
+	/** Slowness amplifier of the stagger (4 = Slowness V). */
+	public static final int STAGGER_SLOWNESS_AMPLIFIER = 4;
+	/** Knockback applied to a parried melee attacker. */
+	public static final double STAGGER_KNOCKBACK = 0.6D;
+
+	// ---- riposte (guaranteed crit after a parry) ------------------------------------------------
+
+	/** How long the guaranteed crit stays available after a successful parry (3s). */
+	public static final int RIPOSTE_TICKS = 60;
+
+	// ---- thrust (every third hit) ---------------------------------------------------------------
+
+	/** Every Nth consecutive hit is a thrust. */
+	public static final int THRUST_EVERY = 3;
+	/** The hit counter resets if no hit lands for this long (3s). */
+	public static final int COMBO_TIMEOUT_TICKS = 60;
+	/** Extra damage of a thrust, as a fraction of the normal hit. */
+	public static final float THRUST_DAMAGE_BONUS = 0.6F;
+	/** Extra reach (blocks) of a thrust. */
+	public static final double THRUST_REACH_BONUS = 1.0D;
+
+	public static final Identifier THRUST_REACH_ID = Armory.id("rapier_thrust_reach");
+
+	private static final class State {
+		long parryEndsAt = -1L;
+		boolean parryLanded;
+		Item parryItem;
+
+		long riposteUntil = -1L;
+
+		int hits;
+		long lastHitAt = Long.MIN_VALUE;
+	}
+
+	private static final Map<UUID, State> STATES = new ConcurrentHashMap<>();
+
+	private static State state(Player player) {
+		return STATES.computeIfAbsent(player.getUUID(), id -> new State());
+	}
+
+	public static void register() {
+		ServerTickEvents.END_SERVER_TICK.register(RapierCombat::tick);
+		ServerPlayConnectionEvents.DISCONNECT.register((handler, server) -> STATES.remove(handler.getPlayer().getUUID()));
+	}
+
+	// ---- queries ----------------------------------------------------------------------------
+
+	/**
+	 * True while the player's next rapier hit is a thrust. Works on both logical sides: it just
+	 * reads the (synced) reach modifier the server keeps on the player.
+	 */
+	public static boolean isThrustReady(Player player) {
+		AttributeInstance range = player.getAttribute(Attributes.ENTITY_INTERACTION_RANGE);
+		return range != null && range.hasModifier(THRUST_REACH_ID);
+	}
+
+	/** Server only: true while a successful parry has banked a guaranteed crit for the held rapier. */
+	public static boolean hasRiposte(Player player) {
+		if (!(player instanceof ServerPlayer) || !RapierItem.isRapier(player.getMainHandItem())) {
+			return false;
+		}
+		State s = STATES.get(player.getUUID());
+		return s != null && s.riposteUntil >= player.level().getGameTime();
+	}
+
+	// ---- parry ------------------------------------------------------------------------------
+
+	/** Called from {@link RapierItem#use}: opens the parry window and hops the player back. */
+	public static void beginParry(ServerPlayer player, InteractionHand hand) {
+		State s = state(player);
+		s.parryEndsAt = player.level().getGameTime() + PARRY_TICKS;
+		s.parryLanded = false;
+		s.parryItem = player.getItemInHand(hand).getItem();
+
+		hopBack(player);
+		player.level().playSound(null, player.getX(), player.getY(), player.getZ(),
+				SoundEvents.PLAYER_ATTACK_WEAK, SoundSource.PLAYERS, 0.8F, 1.6F);
+	}
+
+	private static void hopBack(ServerPlayer player) {
+		if (player.isPassenger() || player.isInWater() || player.isFallFlying() || player.onClimbable()) {
+			return;
+		}
+		double yaw = Math.toRadians(player.getYRot());
+		// forward is (-sin(yaw), cos(yaw)), so back is the opposite
+		double backX = Math.sin(yaw);
+		double backZ = -Math.cos(yaw);
+		Vec3 motion = player.getDeltaMovement();
+		double y = player.onGround() ? PARRY_HOP_LIFT : motion.y;
+		player.setSprinting(false);
+		player.setDeltaMovement(backX * PARRY_HOP_STRENGTH, y, backZ * PARRY_HOP_STRENGTH);
+		player.hurtMarked = true;
+	}
+
+	/**
+	 * Called from the {@code Player#hurtServer} mixin before any damage is applied.
+	 *
+	 * @return true if the hit was parried and must be discarded
+	 */
+	public static boolean tryParry(ServerPlayer victim, ServerLevel level, DamageSource source) {
+		State s = STATES.get(victim.getUUID());
+		if (s == null || s.parryEndsAt < 0L || s.parryLanded) {
+			return false;
+		}
+		long now = level.getGameTime();
+		if (now > s.parryEndsAt) {
+			return false;
+		}
+		ItemStack parryStack = victim.getUseItem();
+		if (!victim.isUsingItem() || !RapierItem.isRapier(parryStack)) {
+			return false;
+		}
+
+		// only things a shield could have stopped: someone (or something) actually hit us
+		if (source.is(DamageTypeTags.BYPASSES_INVULNERABILITY)
+				|| source.is(DamageTypeTags.BYPASSES_SHIELD)
+				|| source.is(DamageTypeTags.IS_EXPLOSION)
+				|| source.is(DamageTypes.THORNS)) {
+			return false;
+		}
+		Entity direct = source.getDirectEntity();
+		if (direct == null) {
+			return false;
+		}
+
+		// must come from the front half, like a shield
+		Vec3 origin = source.getSourcePosition() != null ? source.getSourcePosition() : direct.position();
+		Vec3 toSource = new Vec3(origin.x - victim.getX(), 0.0D, origin.z - victim.getZ());
+		if (toSource.lengthSqr() > 1.0E-6D) {
+			Vec3 facing = Vec3.directionFromRotation(0.0F, victim.getYHeadRot());
+			if (facing.dot(toSource.normalize()) <= 0.0D) {
+				return false;
+			}
+		}
+
+		// success
+		s.parryLanded = true;
+		s.parryEndsAt = -1L;
+		s.parryItem = null;
+		s.riposteUntil = now + RIPOSTE_TICKS;
+		victim.getCooldowns().addCooldown(parryStack, PARRY_SUCCESS_COOLDOWN_TICKS);
+
+		parryEffects(victim, level);
+
+		// melee attackers get staggered, projectiles just bounce off
+		if (direct == source.getEntity() && direct instanceof LivingEntity attacker) {
+			stagger(victim, attacker, source);
+		}
+		return true;
+	}
+
+	private static void parryEffects(ServerPlayer victim, ServerLevel level) {
+		Vec3 at = victim.getEyePosition().add(victim.getLookAngle().scale(0.9D)).add(0.0D, -0.25D, 0.0D);
+		level.sendParticles(ColorParticleOption.create(ParticleTypes.FLASH, 1.0F, 1.0F, 1.0F),
+				at.x, at.y, at.z, 1, 0.0D, 0.0D, 0.0D, 0.0D);
+		level.sendParticles(ParticleTypes.CRIT, at.x, at.y, at.z, 12, 0.25D, 0.25D, 0.25D, 0.35D);
+		level.sendParticles(ParticleTypes.ELECTRIC_SPARK, at.x, at.y, at.z, 8, 0.2D, 0.2D, 0.2D, 0.4D);
+		level.playSound(null, at.x, at.y, at.z, SoundEvents.SHIELD_BLOCK.value(), SoundSource.PLAYERS, 1.0F, 1.6F);
+		level.playSound(null, at.x, at.y, at.z, SoundEvents.AMETHYST_BLOCK_CHIME, SoundSource.PLAYERS, 1.0F, 1.9F);
+	}
+
+	private static void stagger(ServerPlayer victim, LivingEntity attacker, DamageSource source) {
+		// shove them away from us. LivingEntity#knockback subtracts the vector it is given.
+		attacker.knockback(STAGGER_KNOCKBACK, victim.getX() - attacker.getX(), victim.getZ() - attacker.getZ(), source, 0.0F);
+		attacker.hurtMarked = true;
+		attacker.stopUsingItem();
+		attacker.addEffect(new MobEffectInstance(MobEffects.SLOWNESS, STAGGER_TICKS, STAGGER_SLOWNESS_AMPLIFIER, false, true));
+		if (attacker instanceof Mob mob) {
+			mob.getNavigation().stop();
+		}
+		if (attacker instanceof Player other) {
+			// wipes their attack cooldown, so their next swing is a weak one
+			other.resetAttackStrengthTicker();
+		}
+	}
+
+	// ---- hit counter / thrust -----------------------------------------------------------------
+
+	/** Called from {@link RapierItem#postHurtEnemy} after a rapier hit has landed. */
+	public static void onHit(ServerPlayer player, LivingEntity target) {
+		State s = state(player);
+		long now = player.level().getGameTime();
+		boolean wasThrust = isThrustReady(player);
+
+		// the riposte crit is spent by the hit it was for
+		s.riposteUntil = -1L;
+
+		if (now - s.lastHitAt > COMBO_TIMEOUT_TICKS) {
+			s.hits = 0;
+		}
+		if (wasThrust) {
+			s.hits = 0;
+			thrustEffects(player, target);
+		} else {
+			s.hits++;
+		}
+		s.lastHitAt = now;
+		syncThrustModifier(player, s);
+	}
+
+	private static void thrustEffects(ServerPlayer player, LivingEntity target) {
+		if (!(player.level() instanceof ServerLevel level)) {
+			return;
+		}
+		Vec3 at = target.getBoundingBox().getCenter();
+		level.sendParticles(ParticleTypes.CRIT, at.x, at.y, at.z, 10, 0.2D, 0.2D, 0.2D, 0.3D);
+		level.playSound(null, at.x, at.y, at.z, SoundEvents.PLAYER_ATTACK_KNOCKBACK, SoundSource.PLAYERS, 0.8F, 1.5F);
+	}
+
+	private static void syncThrustModifier(ServerPlayer player, State s) {
+		AttributeInstance range = player.getAttribute(Attributes.ENTITY_INTERACTION_RANGE);
+		if (range == null) {
+			return;
+		}
+		boolean want = s.hits >= THRUST_EVERY - 1 && RapierItem.isRapier(player.getMainHandItem());
+		boolean has = range.hasModifier(THRUST_REACH_ID);
+		if (want && !has) {
+			range.addTransientModifier(new AttributeModifier(THRUST_REACH_ID, THRUST_REACH_BONUS, AttributeModifier.Operation.ADD_VALUE));
+		} else if (!want && has) {
+			range.removeModifier(THRUST_REACH_ID);
+		}
+	}
+
+	// ---- per tick -----------------------------------------------------------------------------
+
+	private static void tick(MinecraftServer server) {
+		for (ServerPlayer player : server.getPlayerList().getPlayers()) {
+			tickPlayer(player);
+		}
+	}
+
+	private static void tickPlayer(ServerPlayer player) {
+		State s = STATES.get(player.getUUID());
+		if (s == null) {
+			return;
+		}
+		if (!player.isAlive()) {
+			STATES.remove(player.getUUID());
+			return;
+		}
+		long now = player.level().getGameTime();
+
+		// parry window ran out without catching anything: whiff
+		if (s.parryEndsAt >= 0L && now > s.parryEndsAt) {
+			if (!s.parryLanded && s.parryItem != null) {
+				player.getCooldowns().addCooldown(new ItemStack(s.parryItem), PARRY_WHIFF_COOLDOWN_TICKS);
+			}
+			s.parryEndsAt = -1L;
+			s.parryLanded = false;
+			s.parryItem = null;
+		}
+
+		if (s.riposteUntil >= 0L && now > s.riposteUntil) {
+			s.riposteUntil = -1L;
+		}
+		if (s.hits > 0 && now - s.lastHitAt > COMBO_TIMEOUT_TICKS) {
+			s.hits = 0;
+		}
+
+		syncThrustModifier(player, s);
+	}
+}
diff -ruN src/src/main/java/com/aura/lamplight/armory/RapierItem.java work/src/main/java/com/aura/lamplight/armory/RapierItem.java
--- src/src/main/java/com/aura/lamplight/armory/RapierItem.java	1970-01-01 00:00:00.000000000 +0000
+++ work/src/main/java/com/aura/lamplight/armory/RapierItem.java	2026-11-13 09:37:14.726943068 +0000
@@ -0,0 +1,113 @@
+package com.aura.lamplight.armory;
+
+import java.util.function.Consumer;
+
+import net.minecraft.ChatFormatting;
+import net.minecraft.core.component.DataComponents;
+import net.minecraft.core.registries.Registries;
+import net.minecraft.network.chat.Component;
+import net.minecraft.resources.Identifier;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.tags.TagKey;
+import net.minecraft.world.InteractionHand;
+import net.minecraft.world.InteractionResult;
+import net.minecraft.world.damagesource.DamageSource;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.LivingEntity;
+import net.minecraft.world.entity.player.Player;
+import net.minecraft.world.item.Item;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.item.ToolMaterial;
+import net.minecraft.world.item.TooltipFlag;
+import net.minecraft.world.item.component.TooltipDisplay;
+import net.minecraft.world.level.Level;
+import org.jspecify.annotations.Nullable;
+
+/**
+ * Rapier: a fast single-target sword that is all about timing.
+ *
+ * <ul>
+ *   <li>Left click: normal sword hits, except every third hit in a row is a precise thrust
+ *       (extra damage, extra reach, no sweep). See {@link RapierCombat}.</li>
+ *   <li>Right click: hop back and open a short parry window. A successful parry negates the hit,
+ *       staggers the attacker and guarantees a crit on the next attack. A whiffed parry puts the
+ *       rapier on cooldown.</li>
+ * </ul>
+ *
+ * All of the actual state lives in {@link RapierCombat}; this class only wires the item hooks.
+ */
+public class RapierItem extends Item {
+	public static final TagKey<Item> RAPIERS =
+			TagKey.create(Registries.ITEM, Identifier.withDefaultNamespace("melee_weapons/rapiers"));
+
+	public RapierItem(ToolMaterial material, float attackDamageBaseline, float attackSpeedBaseline, Properties properties) {
+		super(properties.sword(material, attackDamageBaseline, attackSpeedBaseline));
+	}
+
+	public static boolean isRapier(@Nullable ItemStack stack) {
+		return stack != null && stack.getItem() instanceof RapierItem;
+	}
+
+	@Override
+	public InteractionResult use(final Level level, final Player player, final InteractionHand hand) {
+		ItemStack stack = player.getItemInHand(hand);
+
+		// sword and board: with a blocking item in the offhand, right click raises that instead.
+		// crouch to force the parry anyway.
+		if (hand == InteractionHand.MAIN_HAND
+				&& player.getOffhandItem().has(DataComponents.BLOCKS_ATTACKS)
+				&& !player.isSecondaryUseActive()) {
+			return InteractionResult.PASS;
+		}
+
+		if (player.isUsingItem() || player.getCooldowns().isOnCooldown(stack)) {
+			return InteractionResult.PASS;
+		}
+
+		// start using on both sides so the client plays the blocking pose right away,
+		// everything that actually matters is decided on the server.
+		player.startUsingItem(hand);
+		if (player instanceof ServerPlayer serverPlayer) {
+			RapierCombat.beginParry(serverPlayer, hand);
+		}
+		return InteractionResult.CONSUME;
+	}
+
+	// the "use" is just the parry window, it ends on its own.
+	@Override
+	public int getUseDuration(final ItemStack stack, final LivingEntity user) {
+		return RapierCombat.PARRY_TICKS;
+	}
+
+	@Override
+	public void postHurtEnemy(final ItemStack stack, final LivingEntity target, final LivingEntity attacker) {
+		super.postHurtEnemy(stack, target, attacker);
+		if (attacker instanceof ServerPlayer player) {
+			RapierCombat.onHit(player, target);
+		}
+	}
+
+	@Override
+	public float getAttackDamageBonus(final Entity victim, final float damage, final DamageSource damageSource) {
+		if (damageSource.getEntity() instanceof Player attacker && RapierCombat.isThrustReady(attacker)) {
+			return damage * RapierCombat.THRUST_DAMAGE_BONUS;
+		}
+		return super.getAttackDamageBonus(victim, damage, damageSource);
+	}
+
+	@Override
+	@SuppressWarnings("deprecation")
+	public void appendHoverText(
+			final ItemStack stack,
+			final Item.TooltipContext context,
+			final TooltipDisplay display,
+			final Consumer<Component> builder,
+			final TooltipFlag flag
+	) {
+		super.appendHoverText(stack, context, display, builder, flag);
+		builder.accept(Component.translatable("tooltip.lamplight.rapier.parry")
+				.withStyle(style -> style.withColor(ChatFormatting.GRAY).withItalic(false)));
+		builder.accept(Component.translatable("tooltip.lamplight.rapier.thrust")
+				.withStyle(style -> style.withColor(ChatFormatting.GRAY).withItalic(false)));
+	}
+}
diff -ruN src/src/main/java/com/aura/lamplight/mixin/armory/PlayerRapierMixin.java work/src/main/java/com/aura/lamplight/mixin/armory/PlayerRapierMixin.java
--- src/src/main/java/com/aura/lamplight/mixin/armory/PlayerRapierMixin.java	1970-01-01 00:00:00.000000000 +0000
+++ work/src/main/java/com/aura/lamplight/mixin/armory/PlayerRapierMixin.java	2026-11-13 13:42:15.086383552 +0000
@@ -0,0 +1,53 @@
+package com.aura.lamplight.mixin.armory;
+
+import com.aura.lamplight.armory.RapierCombat;
+import com.aura.lamplight.armory.RapierItem;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.world.damagesource.DamageSource;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.player.Player;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.injection.At;
+import org.spongepowered.asm.mixin.injection.Inject;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfoReturnable;
+
+// hooks for the rapier: parrying incoming hits, the riposte crit and the no-sweep thrust.
+@Mixin(Player.class)
+public abstract class PlayerRapierMixin {
+
+	// parry: discard the hit before any damage, knockback or invulnerability frames happen
+	@Inject(method = "hurtServer", at = @At("HEAD"), cancellable = true)
+	private void armory$rapierParry(ServerLevel level, DamageSource source, float damage,
+	                                CallbackInfoReturnable<Boolean> cir) {
+		if ((Object) this instanceof ServerPlayer player && RapierCombat.tryParry(player, level, source)) {
+			cir.setReturnValue(false);
+		}
+	}
+
+	// the hit right after a parry is a guaranteed crit...
+	@Inject(method = "canCriticalAttack", at = @At("HEAD"), cancellable = true)
+	private void armory$rapierRiposteCrit(Entity target, CallbackInfoReturnable<Boolean> cir) {
+		if (RapierCombat.hasRiposte((Player) (Object) this)) {
+			cir.setReturnValue(true);
+		}
+	}
+
+	// ...and it also counts as fully charged, so spamming early can't waste it
+	@Inject(method = "getAttackStrengthScale", at = @At("HEAD"), cancellable = true)
+	private void armory$rapierRipostePower(float a, CallbackInfoReturnable<Float> cir) {
+		if (RapierCombat.hasRiposte((Player) (Object) this)) {
+			cir.setReturnValue(1.0F);
+		}
+	}
+
+	// the thrust is a precise single-target stab, it never sweeps
+	@Inject(method = "isSweepAttack", at = @At("HEAD"), cancellable = true)
+	private void armory$rapierThrustNoSweep(boolean fullStrengthAttack, boolean criticalAttack, boolean knockbackAttack,
+	                                        CallbackInfoReturnable<Boolean> cir) {
+		Player self = (Player) (Object) this;
+		if (RapierItem.isRapier(self.getMainHandItem()) && RapierCombat.isThrustReady(self)) {
+			cir.setReturnValue(false);
+		}
+	}
+}
